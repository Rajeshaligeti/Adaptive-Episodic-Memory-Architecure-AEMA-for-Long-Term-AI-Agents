# AEMA LAB Environment Variables Example

# Backend Settings
PROJECT_NAME="AEMA LAB"
VERSION="1.0.0"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./backend/aema_lab.db"
# For PostgreSQL deployment:
# DATABASE_URL="postgresql://user:password@localhost:5432/aema_lab"

MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

# Frontend Settings (in frontend/.env)
VITE_API_URL="http://127.0.0.1:8000/api"
